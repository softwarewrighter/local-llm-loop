{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwable": {
          "name": "Qwable-v1 IQ4_XS (baseline)",
          "tools": true,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 32768, "output": 4096 },
          "options": {}
        },
        "qwen3-coder": {
          "name": "Qwen3-Coder-30B-A3B-Instruct MoE (verified)",
          "tools": true,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 32768, "output": 4096 },
          "options": {}
        },
        "gemma4-26b": {
          "name": "Gemma-4-26B-A4B-it MoE (verified, best quality)",
          "tools": true,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 32768, "output": 4096 },
          "options": {}
        },
        "gemma4-31b": {
          "name": "Gemma-4-31B-it + E2B draft, dense spec-decode (verified)",
          "tools": true,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 16384, "output": 4096 },
          "options": {}
        }
      }
    }
  },
  "model": "llamacpp/qwen3-coder"
}
