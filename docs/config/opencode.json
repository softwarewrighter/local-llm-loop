{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "envelope": {
      "description": "Restricted agent for the orchestrate loop: file/shell tools only, no task/todo wandering",
      "mode": "primary",
      "tools": {
        "task": false,
        "todowrite": false,
        "todoread": false
      }
    }
  },
  "provider": {
