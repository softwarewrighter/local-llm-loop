{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "qwable": {
          "name": "Qwable-v1 IQ4_XS",
          "tools": true,
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "options": {}
        }
      }
    }
  },
  "model": "llamacpp/qwable"
}
